# Copy to .env and fill in.

# Free MapTiler API key (cloud.maptiler.com) — powers the vector map
# style and 3D buildings globally. See README, "Tiles".
VITE_MAPTILER_KEY=your-maptiler-api-key

# Optional. OpenRouteService API key (openrouteservice.org, needs
# signup) — powers in-app turn-by-turn-free directions with real
# distance/time estimates from the business detail sheet. Without
# this, the Directions link falls back to opening Google Maps
# instead, no broken feature either way.
VITE_ORS_KEY=

# Optional. Mapillary access token (mapillary.com/dashboard/developers,
# needs signup) — powers the Street View toggle: crowdsourced
# street-level photos, coverage will be spottier than Google's actual
# Street View, that's the honest tradeoff of not using Google. Without
# this, the toggle button just doesn't render, no broken feature.
VITE_MAPILLARY_TOKEN=

# Satellite view currently ships hardcoded to Esri World Imagery, no
# env var needed. See README, "Satellite imagery" for a known
# licensing caveat on that endpoint that's still an open to-do.
