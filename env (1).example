# Copy to .env and fill in.

DATABASE_URL=postgres://lobster:password@localhost:5432/lobster_maps
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Required by the Nominatim usage policy — identify your app, not a
# generic HTTP client string. Include a real contact. Also reused by
# the Overpass business-seed script (server/src/scripts/seed-from-overpass.ts)
# for both its Overpass and Nominatim requests.
# https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=LobsterMaps/0.1 (contact@yourdomain.example)

# Required to enable the /mcp endpoint (file read/write + command
# execution for Claude, once connected as a custom connector). Generate
# a real random value, e.g. `openssl rand -hex 32` — don't ship a
# placeholder. The endpoint refuses all requests without this set.
MCP_AUTH_TOKEN=
