# Copy to .env and fill in.

# Your self-hosted .pmtiles region extract (see README, "Tiles").
VITE_PMTILES_URL=https://your-domain.example/tiles/region.pmtiles

# Optional. Leave blank to keep the Satellite toggle disabled (it's
# disabled by default, on purpose, rather than pointed at a guessed URL
# I couldn't verify). Two real, legally-clean options — see README,
# "Satellite imagery" — for the actual tradeoffs before picking one:
#   - EOX Sentinel-2 cloudless (s2maps.eu / cloudless.eox.at)
#   - Esri World Imagery, but only via a real ArcGIS Location Platform
#     account, not the bare REST URL most tutorials paste around
# Never Apple's or Google's satellite imagery — same ToS problem as
# their map tiles, see README.
VITE_SATELLITE_TILES_URL=
VITE_SATELLITE_ATTRIBUTION=
